# ==============================================================================
# CKODEX AIOps Platform — Environment Configuration Template
# Copy this file to .env: `cp .env.example .env`
# ==============================================================================

# Platform Environment (development, staging, production)
CKODEX_ENV=development
CKODEX_TENANT=cfyd
CKODEX_WORKSPACE=aiops

# Distributed Compute & Ray Mesh
RAY_ADDRESS=
RAY_DASHBOARD_PORT=8265
RAY_OVERRIDE_RUNTIME_ENV_DEFAULT_EXCLUDES=""

# Experiment Tracking & Observability
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_DISABLE_AGENT_HINT=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Zero-Trust Secrets Management (HashiCorp Vault)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# Serving Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_MODEL_PATH=data/06_models/model.safetensors
